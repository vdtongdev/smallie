# --- OpenRouter (https://openrouter.ai/keys) ---
OPENROUTER_API_KEY=sk-or-v1-...
# Free chat model with tool calling. Check https://openrouter.ai/models?supported_parameters=tools&max_price=0
OPENROUTER_CHAT_MODEL=google/gemma-4-31b-it:free
# Used automatically when the main model is rate-limited or unavailable, tried in order
# (comma-separated). Leave empty to disable. OpenRouter switches inside the same request,
# so it costs no extra request. Prefer models that are good at Vietnamese: weaker ones slip
# words of another script (Chinese, Korean, Thai) into Vietnamese answers.
OPENROUTER_FALLBACK_MODEL=google/gemma-4-26b-a4b-it:free,nvidia/nemotron-3-super-120b-a12b:free
# Paid models only: provider precisions to allow (comma-separated), e.g. bf16,fp8. OpenRouter
# otherwise picks the cheapest provider, often an fp4 build, whose Vietnamese slips into other
# scripts more. Paid Gemma for good Vietnamese (~$0.14/$0.40 per 1M tokens in bf16):
#   OPENROUTER_CHAT_MODEL=google/gemma-4-31b-it
#   OPENROUTER_FALLBACK_MODEL=google/gemma-4-26b-a4b-it
#   OPENROUTER_QUANTIZATIONS=bf16,fp8
# Free endpoints report no precision, so leave this empty for free models.
OPENROUTER_QUANTIZATIONS=
# Provider order. Empty = OpenRouter's default routing (cheapest first). throughput = fastest
# providers first; recommended with paid models plus OPENROUTER_QUANTIZATIONS, because the
# cheapest bf16/fp8 provider was among the slowest (14 vs 130 tok/s measured). Also: latency,
# price. No effect on free models.
OPENROUTER_PROVIDER_SORT=
# The orchestrator: answers general questions itself, hands a message to one agent, or asks
# several agents and writes the answer. Obvious questions (a ticker, "stock", a file name...)
# skip it. Needs good tool calling and Vietnamese. Leave empty to use OPENROUTER_CHAT_MODEL.
OPENROUTER_ORCHESTRATOR_MODEL=
# Model calls the orchestrator may make per message (deciding + writing up; its agents' calls not included).
ORCHESTRATOR_MAX_MODEL_CALLS=4
# Embeddings. bge-m3 is multilingual (good Vietnamese), ~$0.01 per 1M tokens, 1024 dims.
# Free alternative: liquid/lfm-2.5-embedding-350m:free (EMBED_DIM=1024, may train on your data).
# Changing the model or EMBED_DIM requires: uv run python -m scripts.reindex
OPENROUTER_EMBED_MODEL=baai/bge-m3
EMBED_DIM=1024

# --- Postgres (docker compose maps it to host port 5433) ---
DATABASE_URL=postgresql://smallie:smallie@localhost:5433/smallie
# Read-only role used by the SQL agent
READONLY_DATABASE_URL=postgresql://agent_readonly:readonly@localhost:5433/smallie

# --- Accounts ---
# Everyone creates their own account on the login screen (own chats, documents, memories).
# APP_PASSWORD is the password of the "admin" account, which can also manage accounts.
# Empty = no admin account.
APP_PASSWORD=
# Signs the login cookie. Required when APP_PASSWORD is set; without it everyone is logged
# out whenever the server restarts. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SESSION_SECRET=
# Set to true once the app is served over HTTPS.
SESSION_HTTPS_ONLY=false
# Accounts people can create (the admin is not counted).
MAX_ACCOUNTS=20

# --- App ---
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=25
SQL_MAX_ROWS=200
# Max model calls an agent may make for one message; protects the free quota from tool loops.
MAX_MODEL_CALLS=6
# Agents see the latest questions of the user's other chats and can search all past chats
# (only that account's own chats).
CROSS_CHAT_HISTORY=true
# The app updates stock prices every weekday at this New York time (after the 16:00 close);
# company profiles are refreshed weekly. Empty disables it (then run scripts.load_stocks yourself).
MARKET_UPDATE_TIME=17:30

# --- Research agent ---
# Web search through Tavily's remote MCP server (https://app.tavily.com, free 1,000 credits/month).
# Empty = no web search; the agent still uses Wikipedia, arXiv, the stock database and your files.
TAVILY_API_KEY=
# Extra remote MCP servers (streamable_http or sse) as one line of JSON; their tools are named <name>_<tool>.
# Example: MCP_SERVERS={"exa": {"transport": "streamable_http", "url": "https://mcp.exa.ai/mcp", "headers": {"x-api-key": "..."}}}
MCP_SERVERS=
# Another Postgres the agent may read (external_db MCP server: list_tables, describe_table, query).
# Read-only transactions, 10 s timeout, single SELECT only; still, use a SELECT-only role. Empty = none.
EXTERNAL_DATABASE_URL=
# Model calls the researcher may make per message (the orchestrator writes the answer on top).
RESEARCH_MAX_MODEL_CALLS=8

# --- LangSmith tracing (debugging, https://smith.langchain.com; the free plan has a monthly trace limit) ---
# Records every model call, tool call and routing step of each chat. Traces hold the full
# prompts: users' messages, passages of their files, names and memories. Keep it off unless
# you are debugging, and only turn it on in production when you accept that.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=smallie

# --- Remote agents (0.4.0): each specialist runs as its own Agent Server ---
# Route -> URL of every agent server, one line of JSON. Local compose stack:
# AGENT_URLS={"docs": "http://localhost:2101", "sql": "http://localhost:2102", "research": "http://localhost:2103", "chart": "http://localhost:2104"}
AGENT_URLS=
# Shared secret the agent servers require (x-service-token); set the same value for the app and the servers.
SERVICE_TOKEN=
# Seconds one specialist call may take before it fails; generous because of cold starts.
AGENT_TIMEOUT_S=300
# Connections per database engine; the agent services use 2 so all processes fit Neon's connection cap.
DB_POOL_SIZE=5
# Loop guard: model calls one chat message may use, across the orchestrator and every agent server
# (they report theirs). Once reached, no further specialist is called: a backstop on top of the per-agent
# caps. Parallel asks in one step all start before any usage is added, so one step can overshoot it.
MAX_MESSAGE_MODEL_CALLS=30
